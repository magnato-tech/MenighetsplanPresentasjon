rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Salgssiden menighetsplan.no - Påmeldinger og forespørsler om prøveperiode
    // =========================================================================
    // Alle besøkende kan sende inn en registrering (create).
    // Bare produkteiers innloggede Google-konto kan lese, endre og slette.
    match /registrations/{regId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && 
        request.auth.token.email == "magnar.totland@gmail.com";
    }

  }
}
