rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CRM for menighetsplan.no — kundepåmeldinger fra salgssiden.
    // Klienter skal ikke lese eller oppdatere direkte; API bruker Admin SDK.
    match /customers/{customerId} {
      allow create: if false;
      allow read, update, delete: if false;
    }

  }
}
