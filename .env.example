# CRM Firestore (prosjekt menighetsplan-crm)
CRM_FIREBASE_PROJECT_ID=menighetsplan-crm
CRM_FIRESTORE_DATABASE_ID=(default)
# Hele service account JSON på én linje
CRM_FIREBASE_SERVICE_ACCOUNT=

# CRM-innlogging (crm.menighetsplan.no)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Bekreftelses-e-post ved ny bestilling (Resend: API key + verifisert domene i Resend-dashboard)
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=Menighetsplan <hei@menighetsplan.no>

# Lokal CRM-UI på localhost uten crm.localhost
# VITE_FORCE_CRM=true

PORT=3000
